<?xml version="1.0" encoding="utf-8"?>
<!-- Bewusst KEINE INTERNET-Berechtigung: zBoard arbeitet vollständig lokal.
     Hinweis: Debug-Builds von .NET for Android fügen INTERNET für den Debugger automatisch hinzu, Release-Builds nicht. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-permission android:name="android.permission.VIBRATE" />
  <!-- Spracheingabe; wird erst beim ersten Tippen auf das Mikrofon erfragt -->
  <uses-permission android:name="android.permission.RECORD_AUDIO" />

  <!-- Paketsichtbarkeit (ab Android 11): Spracherkennungsdienste finden -->
  <queries>
    <intent>
      <action android:name="android.speech.RecognitionService" />
    </intent>
  </queries>

  <application
      android:label="zBoard"
      android:allowBackup="false"
      android:supportsRtl="true" />
</manifest>
